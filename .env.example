# ============================================================
#  Ejemplo de variables de entorno - copia este archivo como .env
# ============================================================

# URL de ejecución de PostgreSQL. En Vercel/Supabase usa el Transaction pooler (6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:CLAVE@REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# URL para comandos Prisma desde tu computadora. En Supabase usa Session pooler (5432).
# Si se deja vacía, los comandos Prisma usan DATABASE_URL.
DIRECT_URL="postgresql://postgres.PROJECT_REF:CLAVE@REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Secreto para proteger el recordatorio programado en Vercel (mínimo 32 caracteres).
CRON_SECRET=""

# Supabase Storage para imágenes que se suban desde el panel dueño (bucket público).
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# Clave de la API de NVIDIA (FASE 2 - Asistente de IA)
# Consigue tu clave en https://build.nvidia.com (compatible con OpenAI)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODELO="meta/llama-3.1-70b-instruct"

# Avisos transaccionales por correo (Resend; remitente verificado en el proveedor)
RESEND_API_KEY=""
EMAIL_FROM="Glasskin <pedidos@tu-dominio.com>"
EMAIL_REPLY_TO="hola@glasskin.com"

# Revisión automática de recordatorios de reposición en el servidor local persistente (mínimo 5, predeterminado 60)
RECORDATORIOS_INTERVALO_MINUTOS="60"

# WhatsApp Business de atención (código de país + número, solo dígitos; Paraguay: 595...)
# Al configurarlo se activa el botón para continuar la conversación en WhatsApp.
NEXT_PUBLIC_WHATSAPP_PHONE=""

# Protección del panel administrativo en producción
ADMIN_USER=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
